# PostgreSQL Database Configuration for Local Development (Windows PostgreSQL Service)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=textile_accounts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Initial Owner Bootstrap (Required on first startup when app_user table is empty)
# Minimum 12 characters. After logging in and changing password, remove OWNER_PASSWORD from .env
OWNER_USERNAME=owner
OWNER_PASSWORD=InitialPassword123!

